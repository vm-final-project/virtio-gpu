digraph "View B: Three Kinds of One Edge" {
  rankdir=LR;
  node [fontsize=10];
  label="View B: Three Kinds of One Edge"; labelloc=t; fontsize=14;
  subgraph "cluster_vogue" { label="VOGUE (Unikraft) guest"; style=rounded; color="#bbbbbb";
    "vogue:libukggml_vk" [label="libukggml_vk",shape=box,style=filled,fillcolor="#e2f0fd"];
    "vogue:libukvenus" [label="libukvenus",shape=box,style=filled,fillcolor="#e2f0fd"];
    "vogue:libukvirtgpu_drm" [label="libukvirtgpu_drm",shape=box,style=filled,fillcolor="#e2f0fd"];
    "vogue:libukvirtio_gpu" [label="libukvirtio_gpu",shape=box,style=filled,fillcolor="#e2f0fd"];
    "vogue:libukvk_icd" [label="libukvk_icd",shape=box,style=filled,fillcolor="#e2f0fd"];
  }
  subgraph "cluster_seam" { label="Protocol seam"; style=rounded; color="#bbbbbb";
    "seam:ctrlq" [label="VirtIO-GPU control/cursor queues",shape=hexagon,style=filled,fillcolor="#fff3c4"];
    "seam:venus-ring" [label="Venus command ring",shape=hexagon,style=filled,fillcolor="#fff3c4"];
  }
  "vogue:libukggml_vk" -> "vogue:libukvirtio_gpu" [style=dashed,color="#888888",label="select"];
  "vogue:libukvenus" -> "vogue:libukvirtio_gpu" [style=dashed,color="#888888",label="select"];
  "vogue:libukvirtgpu_drm" -> "vogue:libukvirtio_gpu" [style=dashed,color="#888888",label="select"];
  "vogue:libukggml_vk" -> "vogue:libukvirtio_gpu" [color="#3b6fb6",label="uk/virtio_gpu.h"];
  "vogue:libukggml_vk" -> "vogue:libukvirtgpu_drm" [color="#3b6fb6",label="uk/drm_virtgpu.h"];
  "vogue:libukggml_vk" -> "vogue:libukvenus" [color="#3b6fb6",label="uk/venus.h"];
  "vogue:libukvenus" -> "vogue:libukvirtio_gpu" [color="#3b6fb6",label="uk/virtio_gpu.h"];
  "vogue:libukvirtgpu_drm" -> "vogue:libukvirtio_gpu" [color="#3b6fb6",label="uk/virtio_gpu.h"];
  "vogue:libukvk_icd" -> "vogue:libukvirtgpu_drm" [color="#3b6fb6",label="uk/drm_virtgpu.h"];
  "vogue:libukvk_icd" -> "vogue:libukvirtio_gpu" [color="#3b6fb6",label="uk/virtio_gpu.h"];
  "vogue:libukggml_vk" -> "vogue:libukvenus" [penwidth=2.2,color="#c0392b",label="vk cmd encode"];
  "vogue:libukvenus" -> "vogue:libukvirtio_gpu" [penwidth=2.2,color="#c0392b",label="VENUS ring submit"];
  "vogue:libukvirtgpu_drm" -> "vogue:libukvirtio_gpu" [penwidth=2.2,color="#c0392b",label="EXECBUFFER ioctl"];
  "vogue:libukvirtio_gpu" -> "seam:ctrlq" [penwidth=2.2,color="#c0392b",label="VIRTIO_GPU_CMD_*"];
  "vogue:libukvenus" -> "seam:venus-ring" [penwidth=2.2,color="#c0392b",label="VK command stream"];
}
