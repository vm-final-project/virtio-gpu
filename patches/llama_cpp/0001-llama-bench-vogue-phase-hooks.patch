+// VOGUE Venus-path profiling (libukvirtio_gpu). Declared weak so a plain
+// llama-bench build without the Unikraft profiling library still links; in the
+// VOGUE bench appliance these resolve to the real per-phase counters. The hooks
+// below set the phase per test (pp->prompt, tg->decode) and drop each test's
+// warmup contribution so the report reflects only the measured reps.
+extern "C" {
+    __attribute__((weak)) void vogue_prof_set_phase(int phase);
+    __attribute__((weak)) void vogue_prof_reset_phase(int phase);
+}
+#define VOGUE_PROF_PHASE_PROMPT 0
+#define VOGUE_PROF_PHASE_DECODE 1
+static inline void vogue_bench_phase(const struct cmd_params_instance & inst, bool reset) {
+    int phase = inst.n_prompt > 0 ? VOGUE_PROF_PHASE_PROMPT : VOGUE_PROF_PHASE_DECODE;
+    if (vogue_prof_set_phase) {
+        vogue_prof_set_phase(phase);
+    }
+    if (reset && vogue_prof_reset_phase) {
+        vogue_prof_reset_phase(phase);
+    }
+}
