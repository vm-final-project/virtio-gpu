index f131487..43263f7 100644
--- a/lib/posix-sysinfo/sysinfo.c
+++ b/lib/posix-sysinfo/sysinfo.c
@@ -108,14 +108,28 @@ UK_SYSCALL_R_DEFINE(int, sysinfo, struct sysinfo *, info)
 	return 0;
 }
 
-long fpathconf(int fd __unused, int name __unused)
+long fpathconf(int fd __unused, int name)
 {
-	return 0;
+	return pathconf(NULL, name);
 }
 
-long pathconf(const char *path __unused, int name __unused)
+long pathconf(const char *path __unused, int name)
 {
-	return 0;
+	/*
+	 * Return sane limits for the queries that matter; notably
+	 * _PC_PATH_MAX, which libc++'s std::filesystem::current_path() uses to
+	 * size the getcwd() buffer. Returning 0 there made it call
+	 * getcwd(buf, 0) -> EINVAL and throw, crashing any code that touches
+	 * std::filesystem (e.g. ggml_backend_load_all()).
+	 */
+	switch (name) {
+	case _PC_PATH_MAX:
+		return 4096;
+	case _PC_NAME_MAX:
+		return 255;
+	default:
+		return 0;
+	}
 }
 
 long sysconf(int name)
