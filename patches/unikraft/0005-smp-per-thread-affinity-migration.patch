+int uk_sched_thread_migrate_current(struct uk_sched *target)
+{
+	struct uk_thread *thread;
+	struct uk_sched *source;
+
+	if (!target)
+		return -EINVAL;
+
+	thread = uk_thread_current();
+	UK_ASSERT(thread);
+
+	source = thread->sched;
+	UK_ASSERT(source);
+
+	if (source == target)
+		return 0;
+
+	if (!source->thread_migrate)
+		return -ENOTSUP;
+
+	return source->thread_migrate(source, thread, target);
+}
+
+static struct uk_thread *resolve_affinity_thread(int pid)
+{
+	if (pid == 0)
+		return uk_thread_current();
+
+#if CONFIG_LIBPOSIX_PROCESS_MULTITHREADING
+	if (pid > 0)
+		return uk_posix_thread_from_tid(pid);
+#endif
+
+	return NULL;
+}
+
+static int affinity_current_owner(const struct uk_thread *thread)
+{
+#if CONFIG_LIBUKSCHEDCOOP_SMP
+	int lcpu;
+
+	UK_ASSERT(thread);
+	UK_ASSERT(thread->sched);
+
+	lcpu = uk_schedcoop_smp_lcpu(thread->sched);
+	return lcpu >= 0 ? lcpu : 0;
+#else
+	UK_ASSERT(thread);
+	UK_ASSERT(thread->sched);
+	return 0;
+#endif
+}
