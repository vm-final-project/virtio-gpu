+void uk_sched_affinity_fill(struct uk_sched_cpu_mask *mask)
+{
+	struct uk_thread *current;
+
+	UK_ASSERT(mask);
+	uk_sched_affinity_ready_online(mask);
+	current = uk_thread_current();
+
+	/*
+	 * Parentless bootstrap threads run before their local scheduler may be
+	 * published as ready. Preserve the local LCPU in the inherited mask so
+	 * AP init threads do not exclude themselves during startup.
+	 */
+	if (!current) {
+		unsigned int lcpu_idx = uk_pcpuvar_current_get(uk_pcpuvar_cpu_idx);
+
+		if (lcpu_idx < CONFIG_UKPLAT_CPU_MAXCOUNT)
+			uk_bitmap_set(mask->bits, lcpu_idx, 1);
+	}
+
+	/*
+	 * Early bootstrap threads are created before the ready scheduler
+	 * registry is populated. Keep them executable everywhere configured so
+	 * later inherited masks do not collapse to CPU0 only.
+	 */
+	if (uk_sched_affinity_empty(mask))
+		uk_bitmap_fill(mask->bits, CONFIG_UKPLAT_CPU_MAXCOUNT);
+}
+
+int uk_sched_affinity_intersect(struct uk_sched_cpu_mask *dst,
+				const struct uk_sched_cpu_mask *requested)
+{
+	struct uk_sched_cpu_mask online;
+	unsigned int i;
+
+	UK_ASSERT(dst);
+	UK_ASSERT(requested);
+
+	uk_sched_affinity_ready_online(&online);
+	for (i = 0; i < UK_SCHED_CPU_MASK_WORDS; i++)
+		dst->bits[i] = requested->bits[i] & online.bits[i];
+
+	return uk_sched_affinity_empty(dst) ? -EINVAL : 0;
+}
+
+bool uk_sched_affinity_test(const struct uk_sched_cpu_mask *mask,
+			    unsigned int lcpu_idx)
+{
+	UK_ASSERT(mask);
+
+	if (lcpu_idx >= CONFIG_UKPLAT_CPU_MAXCOUNT)
+		return false;
+
+	return uk_test_bit(lcpu_idx, mask->bits);
+}
+
+int uk_sched_affinity_target(const struct uk_sched_cpu_mask *mask,
+			     int current_lcpu)
+{
+	unsigned int target;
+
+	UK_ASSERT(mask);
+
+	if (current_lcpu >= 0 &&
+	    uk_sched_affinity_test(mask, (unsigned int)current_lcpu))
+		return current_lcpu;
+
+	target = uk_find_next_bit(mask->bits, CONFIG_UKPLAT_CPU_MAXCOUNT, 0);
+	if (target >= CONFIG_UKPLAT_CPU_MAXCOUNT)
+		return -EINVAL;
+
+	return (int)target;
+}
