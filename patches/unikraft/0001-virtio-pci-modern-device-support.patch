+/* Resolve a virtio shared-memory region (PCI cfg_type 8) by id to its mapped
+ * host-visible MMIO window. Consumed by libukvirtio_gpu for host-visible blob
+ * mapping (MAP_BLOB). Returns 0 with *base/*len set on success; -ENOTSUP when
+ * the device is legacy or exposed no shared-memory region; -ENOENT when no
+ * region matches `id`. Non-static so the (extern) caller in libukvirtio_gpu
+ * binds to this strong definition at final link. */
+int virtio_pci_shm_region_get(struct virtio_dev *vdev, __u8 id,
+			      void **base, __u64 *len)
+{
+	struct virtio_pci_dev *vpdev;
+
+	if (unlikely(!vdev || !base || !len))
+		return -EINVAL;
+
+	vpdev = to_virtiopcidev(vdev);
+	if (!vpdev->is_modern || !vpdev->modern_shm_base || !vpdev->modern_shm_len)
+		return -ENOTSUP;
+	if (vpdev->modern_shm_id != id)
+		return -ENOENT;
+
+	*base = (void *)(unsigned long)vpdev->modern_shm_base;
+	*len = vpdev->modern_shm_len;
+	return 0;
+}
