+	vpci_dev->is_modern = 1;
+	vpci_dev->vdev.cops = &vpci_modern_ops;
+	/* Derive virtio_id from PCI device ID: 0x1040 + virtio_id */
+	vpci_dev->vdev.id.virtio_device_id =
+		(__u16)(pci_dev->id.device_id - VIRTIO_PCI_MODERN_DEVICEID_START);
+
+	uk_pr_info("Added modern virtio-pci device %04x (virtio_id=%04x)\n",
+		   pci_dev->id.device_id,
+		   vpci_dev->vdev.id.virtio_device_id);
