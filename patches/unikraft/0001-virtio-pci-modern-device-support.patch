+	if (pci_dev->id.device_id < VIRTIO_PCI_MODERN_DEVICEID_START) {
+		uk_pr_err("Not a modern virtio device: %04x\n",
+			  pci_dev->id.device_id);
+		return -EINVAL;
+	}
+
+	rc = virtio_pci_find_modern_caps(pci_dev, vpci_dev);
+	if (rc != 0) {
+		uk_pr_err("Failed to find modern VirtIO-PCI capabilities: %d\n", rc);
+		return rc;
+	}
