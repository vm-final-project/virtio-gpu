+static int schedcoop_thread_migrate(struct uk_sched *source_s,
+				    struct uk_thread *thread,
+				    struct uk_sched *target_s)
+{
+	struct schedcoop *source = uksched2schedcoop(source_s);
+	struct schedcoop *target = uksched2schedcoop(target_s);
+	struct schedcoop *first, *second;
+	struct uk_thread *next;
+	unsigned long flags;
+	__snsec now;
+
+	UK_ASSERT(thread == uk_thread_current());
+	UK_ASSERT(thread->sched == source_s);
+	UK_ASSERT(source_s != target_s);
+	UK_ASSERT(!uk_thread_is_exited(thread));
+
+	first = source;
+	second = target;
+	if (target->lcpu_idx < source->lcpu_idx) {
+		first = target;
+		second = source;
+	}
+
+	flags = uk_lcpu_save_irqf();
+	uk_spin_lock(&first->queue_lock);
+	if (second != first)
+		uk_spin_lock(&second->queue_lock);
+
+	now = ukplat_monotonic_clock();
+	thread->sched = target_s;
+	UK_TAILQ_REMOVE(&source_s->thread_list, thread, thread_list);
+	UK_TAILQ_INSERT_TAIL(&target_s->thread_list, thread, thread_list);
+	UK_TAILQ_INSERT_TAIL(&target->run_queue, thread, queue);
+
+#if CONFIG_LIBUKSCHED_PLACEMENT_TRACE
+	uk_pr_info("SMPPLACE migrate thread=%p source=%u target=%u\n",
+		   thread, source->lcpu_idx, target->lcpu_idx);
+#endif /* CONFIG_LIBUKSCHED_PLACEMENT_TRACE */
+
+	next = schedcoop_schedule_locked(source, source_s, thread, now, false);
+	uk_thread_clear_queueable(thread);
+
+	if (second != first)
+		uk_spin_unlock(&second->queue_lock);
+	uk_spin_unlock(&first->queue_lock);
+
+	{
+		__u64 target_lcpu = target->lcpu_idx;
+		unsigned int one = 1;
+
+		uk_lcpu_wakeup(&target_lcpu, &one);
+	}
+
+	uk_lcpu_restore_irqf(flags);
+
+	if (next != thread) {
+		if (next != &source->idle)
+			uk_sched_stats_next_count_incr(source_s);
+		uk_sched_thread_switch(next);
+	}
+
+	UK_ASSERT(uk_thread_current() == thread);
+	UK_ASSERT(thread->sched == target_s);
+
+#if CONFIG_LIBUKSCHED_PLACEMENT_TRACE
+	uk_pr_info("SMPPLACE resume thread=%p actual=%u sched=%p\n",
+		   thread,
+		   uk_pcpuvar_current_get(uk_pcpuvar_cpu_idx),
+		   thread->sched);
+#endif /* CONFIG_LIBUKSCHED_PLACEMENT_TRACE */
+
+	return 0;
 }
 
