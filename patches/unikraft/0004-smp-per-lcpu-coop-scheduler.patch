+/*
+ * A3: per-LCPU cooperative scheduler bring-up.
+ *
+ * Creates one self-contained `ukschedcoop` instance per online secondary
+ * vCPU, starts the AP on a dedicated bootstrap stack, and round-robins newly
+ * created threads across all online per-LCPU schedulers so they run in
+ * parallel.
+ */
+#include <errno.h>
+#include <uk/plat/config.h>
+#include <uk/config.h>
+#include <uk/alloc.h>
+#include <uk/sched.h>
+#include <uk/schedcoop.h>
+#include <uk/lcpu.h>
+#include <uk/lcpu/pm.h>
+#include <uk/pcpuvar.h>
+#include <uk/atomic.h>
+#include <uk/print.h>
+#include <uk/essentials.h>
+#include <uk/compiler.h>
+#include <uk/arch/ctx.h>
+#include "schedcoop.h"
+
+/* Per-LCPU scheduler instances. Index 0 is the BSP scheduler. */
+static struct uk_sched *coop_by_lcpu[CONFIG_UKPLAT_CPU_MAXCOUNT];
+
+/* Low, identity-mapped bootstrap stacks for the APs.
+ *
+ * The platform trampoline jumps to the AP entry on the limited *boot* page
+ * table with whatever SP we hand to uk_lcpu_start(). The main heap and the
+ * stack allocator are vmem-backed (high virtual addresses) that the boot page
+ * table does NOT map, so an AP would triple-fault on its first stack access
+ * before it can adopt the runtime page table. The kernel image (.bss) is
+ * identity-mapped in BOTH the boot and runtime page tables, so a static array
+ * here gives each AP a stack that is valid both before and after the CR3
+ * switch. (This mirrors how Linux gives a secondary CPU a low trampoline
+ * stack before it switches to swapper_pg_dir / its task stack.) Index 0 is
+ * unused (the BSP runs on its boot stack).
+ */
+static __align(UKARCH_SP_ALIGN)
+	char ap_bootstack[CONFIG_UKPLAT_CPU_MAXCOUNT][STACK_SIZE];
+
+/* Round-robin cursor for uk_schedcoop_smp_pick(). */
+static unsigned long rr_cursor;
+
+/* Physical address of the BSP's *runtime* page table (CR3), captured during
+ * bring-up while the BSP is running on the full paging/vmem page table. APs
+ * are started by the platform trampoline on the limited *boot* page table
+ * (x86_bpt_pml4), which does NOT map the high-virtual-address, vmem-backed
+ * stacks (idle/thread stacks come from the stack allocator `sa`). Each AP must
+ * therefore adopt this runtime page table before touching any such memory.
+ */
+static unsigned long runtime_pt_base;
+
+/* The BSP's EFER, captured during bring-up. The AP trampoline only sets
+ * EFER.LME (long mode) and NOT EFER.NXE, but the runtime page table marks
+ * data pages no-execute (NX, bit 63). Walking an NX PTE with EFER.NXE clear
+ * raises a reserved-bit #PF, so the AP must adopt the BSP's EFER (which has
+ * NXE set) BEFORE loading the runtime page table.
+ */
+static unsigned long runtime_efer;
+
+#define X86_MSR_EFER 0xc0000080u
+
+static inline void ap_adopt_runtime_pt(void)
+{
+#if defined(__X86_64__) || defined(__x86_64__)
+	/* 1) Match the BSP's EFER (notably NXE) so NX PTEs are legal. */
+	__asm__ __volatile__("wrmsr"
+			     :: "a"((unsigned int)runtime_efer),
+				"d"((unsigned int)(runtime_efer >> 32)),
+				"c"(X86_MSR_EFER));
+	/* 2) Adopt the BSP's runtime page table (maps the high-vaddr vmem
+	 *    stacks this LCPU's scheduler/threads use).
+	 */
+	__asm__ __volatile__("movq %0, %%cr3" :: "r"(runtime_pt_base) : "memory");
+#endif
+}
+
+static inline struct uk_sched *uk_schedcoop_smp_slot(unsigned int lcpu_idx)
+{
+	if (lcpu_idx >= CONFIG_UKPLAT_CPU_MAXCOUNT)
+		return NULL;
+
+	return uk_load_n(&coop_by_lcpu[lcpu_idx]);
+}
+
+/*
+ * AP entry point.
+ *
+ * NOTE: uk_lcpu_start() hard-codes the argument passed to the entry to be the
+ *       `struct uk_lcpu *` of the started CPU - we cannot pass a custom
+ *       pointer. We therefore recover our scheduler instance from the global
+ *       `coop_by_lcpu` array, indexed by *our own* LCPU index (read from the
+ *       per-CPU `uk_pcpuvar_cpu_idx`).
+ *
+ * This function must never return.
+ */
+static void __noreturn ap_entry(struct uk_lcpu *self)
+{
+	__u64 idx;
+	struct uk_sched *s;
+	int rc;
+
+	/* Finish per-CPU initialization. The default AP entry
+	 * (uk_lcpu_entry_default) calls uk_lcpu_init() before running any user
+	 * entry; because we supply our own entry to uk_lcpu_start(), the
+	 * trampoline jumps straight here and we MUST do it ourselves. This sets
+	 * up exception/trap handling for this CPU (uk_pal_except_init) and marks
+	 * it online. Runs with IRQs still disabled and on the boot page table,
+	 * exactly as the default entry expects.
+	 */
+	rc = uk_lcpu_init(self);
+	if (unlikely(rc))
+		uk_lcpu_halt();
+
+	/* The platform trampoline jumps here on the limited boot page table with
+	 * a LOW (boot-PT-mapped) bootstrap stack (see uk_schedcoop_smp_bringup).
+	 * Immediately adopt the BSP's runtime page table so the high-vaddr
+	 * vmem-backed stacks (this scheduler's idle thread, and any threads later
+	 * placed on this LCPU) are reachable. The low bootstrap stack is identity-
+	 * mapped in both page tables, so switching here is safe.
+	 */
+	ap_adopt_runtime_pt();
+
+	idx = uk_pcpuvar_current_get(uk_pcpuvar_cpu_idx);
+	s = uk_schedcoop_smp_slot((unsigned int)idx);
+
+	UK_ASSERT(s);
+
+	uk_pr_info("SMP: scheduler online on LCPU %lu\n", (unsigned long)idx);
+#if CONFIG_LIBUKSCHED_PLACEMENT_TRACE
+	uk_pr_info("SMPPLACE online lcpu=%u sched=%p\n", (unsigned int)idx, s);
+#endif /* CONFIG_LIBUKSCHED_PLACEMENT_TRACE */
+
+	/* uk_sched_start() is AP-safe as-is: on a fresh AP uk_thread_current()
+	 * is NULL and `s` is a distinct, not-yet-started instance, so its
+	 * preconditions (!s->is_started, !uk_thread_current()) hold per-AP. It
+	 * allocates the per-CPU "init"/current thread (whose ->sched is this
+	 * local instance, making uk_sched_current() correct on this LCPU) and
+	 * calls schedcoop_start() which enables IRQs.
+	 */
+	uk_sched_start(s);
+
+	/* schedcoop_start() already enables IRQs, but be explicit/defensive. */
+	uk_lcpu_enable_irq();
+
+	/* Cooperatively run whatever gets placed on this LCPU. When the run
+	 * queue is empty, schedcoop schedules its idle thread which halts the
+	 * CPU until an IRQ (e.g. a cross-CPU wakeup from schedcoop_thread_add)
+	 * arrives.
+	 */
+	for (;;)
+		uk_sched_yield();
+}
+
+int uk_schedcoop_smp_bringup(struct uk_alloc *a,
+			     struct uk_alloc *sa,
+			     struct uk_alloc *auxsa)
+{
+	unsigned int started = 0;
+	unsigned int i;
+
+	UK_ASSERT(a);
+	UK_ASSERT(sa);
+	UK_ASSERT(auxsa);
+
+	/* Record the BSP scheduler (the one currently running on this CPU) at
+	 * index 0 so it is valid for round-robin placement.
+	 */
+	uk_store_n(&coop_by_lcpu[0], uk_sched_current());
+	UK_ASSERT(coop_by_lcpu[0]);
+
+	/* Capture the BSP's runtime page table (CR3) now, while we are running on
+	 * the full paging/vmem page table. Each AP adopts it in ap_entry().
+	 */
+#if defined(__X86_64__) || defined(__x86_64__)
+	{
+		unsigned int efer_lo, efer_hi;
+
+		__asm__ __volatile__("movq %%cr3, %0" : "=r"(runtime_pt_base));
+		__asm__ __volatile__("rdmsr"
+				     : "=a"(efer_lo), "=d"(efer_hi)
+				     : "c"(X86_MSR_EFER));
+		runtime_efer = ((unsigned long)efer_hi << 32) | efer_lo;
+	}
+#endif
+
+	for (i = 1; i < CONFIG_UKPLAT_CPU_MAXCOUNT; i++) {
+		struct uk_sched *s;
+		struct schedcoop *c;
+		void *stack;
+		__u64 sp;
+		__u64 lcpuidx[1];
+		__u64 entry[1];
+		__u64 sparr[1];
+		unsigned int num = 1;
+		int rc;
+
+		s = uk_schedcoop_create(a, sa, auxsa, a);
+		if (unlikely(!s)) {
+			uk_pr_warn("SMP: failed to create scheduler for LCPU %u\n",
+				   i);
+			continue;
+		}
+
+		c = uksched2schedcoop(s);
+		c->lcpu_idx = i;
+		uk_store_n(&coop_by_lcpu[i], s);
+
+		/* Use the static, low, identity-mapped bootstrap stack for this
+		 * AP (see ap_bootstack). It must be reachable on the boot page
+		 * table the AP starts on, before ap_entry adopts the runtime PT.
+		 */
+		stack = ap_bootstack[i];
+		sp = ukarch_gen_sp(stack, STACK_SIZE);
+
+		lcpuidx[0] = i;
+		sparr[0]   = sp;
+		entry[0]   = (__u64)ap_entry;
+
+		rc = uk_lcpu_start(lcpuidx, &num, sparr, entry, 0);
+		if (unlikely(rc)) {
+			uk_pr_warn("SMP: uk_lcpu_start(LCPU %u) failed: %d\n",
+				   i, rc);
+			uk_store_n(&coop_by_lcpu[i], NULL);
+			continue;
+		}
+
+		/* `num` reflects how many of the requested CPUs actually
+		 * started (here at most 1).
+		 */
+		if (num >= 1) {
+			started++;
+		} else {
+			uk_pr_warn("SMP: LCPU %u did not start\n", i);
+			uk_store_n(&coop_by_lcpu[i], NULL);
+		}
+	}
+
+#if CONFIG_LIBUKSCHED_PLACEMENT_TRACE
+	uk_pr_info("SMPPLACE online lcpu=0 sched=%p\n", coop_by_lcpu[0]);
+#endif /* CONFIG_LIBUKSCHED_PLACEMENT_TRACE */
+
+	uk_pr_info("SMP: brought up %u secondary scheduler(s) (%u total LCPUs)\n",
+		   started, started + 1);
+
+	return 0;
+}
+
+unsigned int uk_schedcoop_smp_online_count(void)
+{
+	unsigned int i;
+	unsigned int count = 0;
+
+	for (i = 0; i < CONFIG_UKPLAT_CPU_MAXCOUNT; i++) {
+		struct uk_sched *s = uk_load_n(&coop_by_lcpu[i]);
+
+		if (s && uk_load_n(&s->is_started))
+			count++;
+	}
+
+	return count;
+}
+
+struct uk_sched *uk_schedcoop_smp_sched(unsigned int lcpu_idx)
+{
+	struct uk_sched *s;
+
+	if (lcpu_idx >= CONFIG_UKPLAT_CPU_MAXCOUNT)
+		return NULL;
+
+	s = uk_load_n(&coop_by_lcpu[lcpu_idx]);
+	if (!s || !uk_load_n(&s->is_started))
+		return NULL;
+
+	return s;
+}
+
+struct uk_sched *uk_schedcoop_smp_pick(void)
+{
+	unsigned int attempts;
+	unsigned int count;
+	unsigned long n;
+	struct uk_sched *s;
+
+	count = uk_schedcoop_smp_online_count();
+	if (!count)
+		return coop_by_lcpu[0];
+
+	/* Try up to the configured LCPU span, skipping unavailable slots. */
+	for (attempts = 0; attempts < CONFIG_UKPLAT_CPU_MAXCOUNT; attempts++) {
+		n = (unsigned long)uk_fetch_add(&rr_cursor, 1);
+		s = uk_schedcoop_smp_sched(n % CONFIG_UKPLAT_CPU_MAXCOUNT);
+		if (likely(s))
+			return s;
+	}
+
+	/* Fallback: the BSP scheduler is always present. */
+	return coop_by_lcpu[0];
+}
+
+int uk_schedcoop_smp_lcpu(const struct uk_sched *s)
+{
+	unsigned int i;
+
+	if (!s)
+		return -EINVAL;
+
+	for (i = 0; i < CONFIG_UKPLAT_CPU_MAXCOUNT; i++)
+		if (uk_schedcoop_smp_sched(i) == s)
+			return (int)i;
+
+	return -ENOENT;
+}
+
+int uk_schedcoop_smp_migrate_current(unsigned int target_lcpu)
+{
+	struct uk_sched *target;
+
+	target = uk_schedcoop_smp_sched(target_lcpu);
+	if (!target)
+		return -ENOENT;
+
+	return uk_sched_thread_migrate_current(target);
+}
