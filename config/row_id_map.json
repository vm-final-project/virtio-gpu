    "G1sw":                 "gfx.glmark2.sw",
    "U2GL":                 "xport.gl-probe",
    "G5":                   "vk.drm-shim",
    "G6":                   "vk.icd",
    "VABI":                 "proto.real-driver",
    "VQEMU":                "xport.qemu-vgpu",
    "VPERF":                "vk.readiness",
    "VENUS-ENC":            "proto.venus-enc",
    "VENUS-RING":           "proto.venus-ring",
    "VSMOKE":               "vk.smoke",
    "VKMARK":               "gfx.vkmark",
