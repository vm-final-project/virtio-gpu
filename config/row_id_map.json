{
  "schema_version": 1,
  "purpose": "Canonical mapping from legacy cryptic evidence row IDs to the new unified namespace. The namespace is `<kind>.<layer>[.<detail>]` where kind ∈ {proto, xport, disp, gfx, vk, cpu, gpu, llm, host, bld}.",
  "rules": [
    "Every new row ID must appear as a key in `new` below.",
    "Legacy IDs are accepted only inside this file or inside .omx/ (audit history).",
    "scripts/naming_check.py rejects legacy tokens outside the allowlist."
  ],
  "allowlist_paths": [
    "config/row_id_map.json",
    ".omx/",
    "results/.archive/"
  ],
  "mapping": {
    "N2D":                  "disp.2d",
    "G0":                   "proto.api-contract",
    "K1sw":                 "gfx.kmscube.sw",
