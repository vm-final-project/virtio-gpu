{
  "schema_version": 1,
  "description": "VOGUE llama.cpp benchmark environment matrix. This file is dependency-free JSON so CI can validate it without PyYAML.",
  "model": {
    "default_path": "tmp/archive-llm-substrate/models/tiny-random-LlamaForCausalLM-Q2_K.gguf",
    "mount_path": "/mnt/model/model.gguf",
    "description": "tiny-random-LlamaForCausalLM Q2_K for artifact smoke runs"
  },
  "llama_bench_args": {
    "prompt_tokens": [
      128,
      512
    ],
    "gen_tokens": [
      128
    ],
    "repetitions": 5,
    "output_format": "json",
    "extra": []
  },
  "required_families": [
    "baremetal+cuda",
    "baremetal+vulkan",
    "baremetal+cpu",
    "qemu+linux+vulkan",
    "qemu+linux+cpu",
    "qemu+unikraft+vulkan",
    "qemu+unikraft+cpu"
  ],
  "environments": [
    {
      "id": "baremetal-cuda",
      "family": "baremetal+cuda",
      "label": "Baremetal CUDA llama-bench",
      "backend": "CUDA",
      "mode": "bench",
      "threads": [
        4
      ],
      "binary_env": "LLAMA_CUDA_BENCH",
      "binary_default": "/home/jerrytsai/llama.cpp/build-cuda/bin/llama-bench",
      "device_env": "CUDA_VISIBLE_DEVICES",
      "device_default": "0",
      "extra_args": [
        "-ngl",
        "99"
      ],
      "claim_allowed": "Native CUDA llama.cpp baseline on the host GPU.",
      "claim_forbidden": "Unikraft, QEMU, Vulkan, or VirtIO-GPU performance claims."
    },
    {
      "id": "baremetal-vulkan",
      "family": "baremetal+vulkan",
      "label": "Baremetal Vulkan llama-bench",
      "backend": "Vulkan",
      "mode": "bench",
      "threads": [
        4
      ],
      "binary_env": "LLAMA_VULKAN_BENCH",
      "binary_default": "/home/jerrytsai/llama.cpp/build-vulkan/bin/llama-bench",
      "device_env": "GGML_VK_VISIBLE_DEVICES",
      "device_default": "0",
      "extra_args": [
        "-ngl",
        "99"
      ],
      "claim_allowed": "Native Vulkan llama.cpp baseline on a selected host Vulkan device.",
      "claim_forbidden": "Unikraft/Venus throughput or QEMU guest claims."
    },
    {
      "id": "baremetal-cpu",
      "family": "baremetal+cpu",
      "label": "Baremetal CPU llama-bench",
      "backend": "CPU",
      "mode": "bench",
      "threads": [
        1,
        4,
        32
      ],
      "binary_env": "LLAMA_CPU_BENCH",
      "binary_default": "/home/jerrytsai/llama.cpp/build-cpu/bin/llama-bench",
      "extra_args": [],
      "claim_allowed": "Native CPU llama.cpp baseline at explicit thread counts.",
      "claim_forbidden": "GPU, QEMU, or Unikraft claims."
    },
    {
      "id": "qemu-linux-vulkan",
      "family": "qemu+linux+vulkan",
      "label": "QEMU Linux guest Vulkan llama-bench",
      "backend": "Vulkan",
      "mode": "bench",
      "threads": [
        4
      ],
      "runner": "ssh",
      "ssh_env": "QEMU_LINUX_SSH",
      "remote_binary": "/home/bench/llama-bench-vulkan",
      "remote_model": "/home/bench/model.gguf",
      "extra_args": [
        "-ngl",
        "99"
      ],
      "qemu_args": [
        "-enable-kvm",
        "-device",
        "virtio-gpu-gl-pci,hostmem=512M,blob=true,venus=true"
      ],
      "claim_allowed": "Linux guest llama.cpp Vulkan baseline when SSH/QEMU guest evidence is captured.",
      "claim_forbidden": "Unikraft or direct baremetal claims."
    },
    {
      "id": "qemu-linux-cpu",
      "family": "qemu+linux+cpu",
      "label": "QEMU Linux guest CPU llama-bench",
      "backend": "CPU",
      "mode": "bench",
      "threads": [
        1,
        4
      ],
      "runner": "ssh",
      "ssh_env": "QEMU_LINUX_SSH",
      "remote_binary": "/home/bench/llama-bench-cpu",
      "remote_model": "/home/bench/model.gguf",
      "extra_args": [],
      "qemu_args": [
        "-enable-kvm",
        "-smp",
        "4"
      ],
      "claim_allowed": "Linux guest CPU baseline at explicit vCPU/thread counts.",
      "claim_forbidden": "Baremetal or Unikraft claims."
    },
    {
      "id": "qemu-unikraft-vulkan",
      "family": "qemu+unikraft+vulkan",
      "label": "QEMU Unikraft Vulkan llama.cpp bench-only appliance",
      "backend": "Vulkan/Venus",
      "mode": "bench",
      "threads": [
        1
      ],
      "runner": "qemu-unikraft",
      "kraftfile": "kraft/Kraftfile.llama-upstream-vk",
      "image": ".unikraft/build/vogue-llama-upstream-vk_qemu-x86_64",
      "single_app": "app-llama-upstream-vk",
      "qemu_args": [
        "-enable-kvm",
        "-cpu",
        "host",
        "-smp",
        "4",
        "-m",
        "1024M",
        "-device",
        "virtio-gpu-gl-pci,hostmem=512M,blob=true,venus=true"
      ],
      "virtfs_tag": "model",
      "claim_allowed": "Single Unikraft app image running upstream llama.cpp Vulkan bench when QEMU/Venus prerequisites exist.",
      "claim_forbidden": "Shell-based workflow or throughput claim from structured-blocked boots."
    },
    {
      "id": "qemu-unikraft-vulkan-server",
      "family": "qemu+unikraft+vulkan",
      "label": "QEMU Unikraft Vulkan llama.cpp server-only appliance",
      "backend": "Vulkan/Venus",
      "mode": "server",
      "threads": [
        1
      ],
      "runner": "qemu-unikraft",
      "kraftfile": "kraft/Kraftfile.llama-upstream-vk-server",
      "image": ".unikraft/build/vogue-llama-upstream-vk-server_qemu-x86_64",
      "single_app": "app-llama-upstream-vk",
      "qemu_args": [
        "-enable-kvm",
        "-cpu",
        "host",
        "-smp",
        "4",
        "-m",
        "4096M",
        "-display",
        "egl-headless,gl=on",
        "-device",
        "virtio-gpu-gl-pci,hostmem=8G,blob=true,venus=true"
      ],
      "virtfs_tag": "model",
      "claim_allowed": "Single Unikraft app image boots the Vulkan llama.cpp server-mode entrypoint directly when QEMU/Venus prerequisites exist.",
      "claim_forbidden": "ELF-loader, shell, fork/exec launcher, HTTP serving, or throughput claim before same-run runtime/net evidence exists."
    },
    {
      "id": "qemu-unikraft-cpu",
      "family": "qemu+unikraft+cpu",
      "label": "QEMU Unikraft CPU llama.cpp bench-only appliance",
      "backend": "CPU",
      "mode": "bench",
      "threads": [
        1
      ],
      "runner": "qemu-unikraft",
      "kraftfile": "kraft/Kraftfile.llama-upstream-bench",
      "image": ".unikraft/build/vogue-llama-upstream-bench_qemu-x86_64",
      "single_app": "app-llama-upstream",
      "qemu_args": [
        "-enable-kvm",
        "-cpu",
        "host",
        "-smp",
        "1",
        "-m",
        "1024M"
      ],
      "virtfs_tag": "model",
      "claim_allowed": "Single Unikraft app image running upstream llama.cpp CPU bench.",
      "claim_forbidden": "Shell-based workflow or GPU/Vulkan claim."
    },
    {
      "id": "qemu-unikraft-cpu-server",
      "family": "qemu+unikraft+cpu",
      "label": "QEMU Unikraft CPU llama.cpp server-only appliance",
      "backend": "CPU",
      "mode": "server",
      "threads": [
        1
      ],
      "runner": "qemu-unikraft",
      "kraftfile": "kraft/Kraftfile.llama-upstream-server",
      "image": ".unikraft/build/vogue-llama-upstream-server_qemu-x86_64",
      "single_app": "app-llama-upstream",
      "qemu_args": [
        "-enable-kvm",
        "-cpu",
        "host",
        "-smp",
        "1",
        "-m",
        "1024M"
      ],
      "virtfs_tag": "model",
      "claim_allowed": "Single Unikraft app image loading upstream llama.cpp CPU server-mode model/context without a shell.",
      "claim_forbidden": "Full HTTP serving or GPU throughput before Unikraft netdev/lwip and runtime evidence exist."
    }
  ],
  "appliances": [
    {
      "id": "qemu-unikraft-llama-bench-only",
      "mode": "bench",
      "family": "qemu+unikraft+cpu",
      "kraftfile": "kraft/Kraftfile.llama-upstream-bench",
      "single_app": "app-llama-upstream",
      "entrypoint": "main -> run_bench_only",
      "expected_serial": "uk-llama-upstream: PASS evidence_id=llama-upstream-cpu"
    },
    {
      "id": "qemu-unikraft-llama-server-only",
      "mode": "server",
      "family": "qemu+unikraft+cpu",
      "kraftfile": "kraft/Kraftfile.llama-upstream-server",
      "single_app": "app-llama-upstream",
      "entrypoint": "main -> run_server_only",
      "expected_serial": "uk-llama-upstream-server: READY"
    },
    {
      "id": "qemu-unikraft-llama-vulkan-bench-only",
      "mode": "bench",
      "family": "qemu+unikraft+vulkan",
      "kraftfile": "kraft/Kraftfile.llama-upstream-vk",
      "single_app": "app-llama-upstream-vk",
      "entrypoint": "main -> Vulkan bench",
      "expected_serial": "uk-llama-upstream-vk: PASS evidence_id=llama-upstream-vk"
    },
    {
      "id": "qemu-unikraft-llama-vulkan-server-only",
      "mode": "server",
      "family": "qemu+unikraft+vulkan",
      "kraftfile": "kraft/Kraftfile.llama-upstream-vk-server",
      "single_app": "app-llama-upstream-vk",
      "entrypoint": "main -> Vulkan server readiness",
      "expected_serial": "uk-llama-upstream-vk-server: READY"
    }
  ]
}
