spec: v0.6

name: vogue

unikraft:
  source: https://github.com/unikraft/unikraft.git
  version: f6f00b2d9cf4826ed9729bb62738947f82bf1f6e
  kconfig:
    CONFIG_APP_KMSCUBE: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBUKSGLIST: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'
    CONFIG_LIBUKVULKAN_VENUS: 'y'
    CONFIG_LIBUKSWRENDER: 'y'
    CONFIG_LIBUKEGL: 'y'
    CONFIG_LIBUKDRM_COMPAT: 'y'
    CONFIG_LIBUKGBM_COMPAT: 'y'

targets:
- qemu/x86_64
- qemu/arm64

libraries:
  musl: stable
  libukvirtio_gpu:
    source: ./libs/libukvirtio_gpu
  libukvulkan_venus:
    source: ./libs/libukvulkan_venus
  libukswrender:
    source: ./libs/libukswrender
  libukegl:
    source: ./libs/libukegl
  libukdrm_compat:
    source: ./libs/libukdrm_compat
  libukgbm_compat:
    source: ./libs/libukgbm_compat
  app-kmscube:
    source: ./apps/app-kmscube
