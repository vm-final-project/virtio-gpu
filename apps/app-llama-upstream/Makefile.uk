$(eval $(call addlib,appllama_upstream))

# External source roots. LLAMA_ROOT defaults to a sibling checkout next to
# vm-final-project (the same convention used for ../unikraft and ../lib-musl).
# Override via the environment or by exporting it from the top-level Makefile.
LLAMA_ROOT  ?= $(realpath $(APPLLAMA_UPSTREAM_BASE)/../../../llama.cpp)
ifeq ($(strip $(LLAMA_ROOT)),)
$(error LLAMA_ROOT not set and ../llama.cpp sibling not found; export LLAMA_ROOT or set it in config/external_paths.json)
endif
GGML_SRC    := $(LLAMA_ROOT)/ggml/src
GGML_INC    := $(LLAMA_ROOT)/ggml/include
LLAMA_SRC   := $(LLAMA_ROOT)/src
COMPILER_DIR := $(shell clang -print-resource-dir)

# Include paths
APPLLAMA_UPSTREAM_CINCLUDES-y   += -I$(GGML_INC) -I$(GGML_SRC) -I$(GGML_SRC)/ggml-cpu
APPLLAMA_UPSTREAM_CXXINCLUDES-y += -I$(LLAMA_ROOT)/include -I$(LLAMA_SRC) \
                                   -I$(LLAMA_SRC)/models \
                                   -I$(GGML_INC) -I$(GGML_SRC) -I$(GGML_SRC)/ggml-cpu

# Compile flags: enable CPU backend static registration, suppress fortify+glibc compat issues.
#
# Two flag profiles:
#   - COLD: -Os for entrypoint glue, GGUF parser, registry, model-loader and
#     other call-once code. Cuts unikernel image size and keeps the cold path
#     compact.
#   - HOT:  -O3 -funroll-loops -fno-math-errno -fno-trapping-math for the ggml
#     CPU kernels (matmul, quant unpack, RMSNorm, attention) and the llama.cpp
#     graph executor. This is the path that dominates pp512/tg128 throughput.
#
# Per-translation-unit overrides below use the Unikraft convention
# `APP<LIB>_<FILE_UNDERSCORED>_FLAGS-y` to add the HOT flags on top of the COLD
# baseline (later -O wins).
#
# `-fno-asynchronous-unwind-tables` and `-fno-unwind-tables` are C-only so the
# C++ exception-table chain through libc++/libunwind stays intact.
# P2 (plan-optimize.md): target CPU arch is explicit + overridable. Upstream
# ggml disables its native default under cross-compilation, so the appliance must
# state its target. Default `native` is correct on the evaluation host because
# the build host == the KVM run host (`-cpu host`, Broadwell); override
# LLAMA_MARCH=<arch> for cross-host builds where build != run CPU.
LLAMA_MARCH ?= native
APPLLAMA_UPSTREAM_COMMON_DEFS := -DGGML_VERSION=\"0.12.0\" -DGGML_COMMIT=\"fcae601e4\" \
                                  -D_GNU_SOURCE -DGGML_NO_NATIVE=1 -DGGML_USE_CPU=1 \
                                  -march=$(LLAMA_MARCH) -mtune=$(LLAMA_MARCH) \
                                  -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 \
                                  -isystem $(COMPILER_DIR)/include
APPLLAMA_UPSTREAM_COLD_FLAGS    := -Os -ffunction-sections -fdata-sections
APPLLAMA_UPSTREAM_C_COLD_EXTRA  := -fno-asynchronous-unwind-tables -fno-unwind-tables
APPLLAMA_UPSTREAM_HOT_FLAGS     := -O3 -funroll-loops -fno-math-errno -fno-trapping-math

APPLLAMA_UPSTREAM_CFLAGS-y   += $(APPLLAMA_UPSTREAM_COMMON_DEFS) $(APPLLAMA_UPSTREAM_COLD_FLAGS) \
                                 $(APPLLAMA_UPSTREAM_C_COLD_EXTRA) \
                                 -Wno-unused-function
APPLLAMA_UPSTREAM_CXXFLAGS-y += -std=c++17 $(APPLLAMA_UPSTREAM_COMMON_DEFS) $(APPLLAMA_UPSTREAM_COLD_FLAGS) \
                                 -Wno-unknown-pragmas -Wno-unused-function
# NOTE: --gc-sections must NOT go here: per-library LDFLAGS feed the relocatable
# `ld -r` link, where --gc-sections has no entry-point root and binutils errors
# out. Dead-section elimination is requested at the final image link instead via
# CONFIG_OPTIMIZE_DEADELIM (see the Kraftfiles). -ffunction-sections/-fdata-sections
# above keep the per-symbol sections that the final --gc-sections then drops.
APPLLAMA_UPSTREAM_LDFLAGS-y  += -Wl,--build-id=none -Wl,--hash-style=gnu

# Per-file HOT overrides. The base name in the variable is the source filename
# with `-` and `.` replaced by `_`, ext dropped.
# ── ggml core hot kernels ────────────────────────────────────────────────
APPLLAMA_UPSTREAM_GGML_FLAGS-y         += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_GGML_ALLOC_FLAGS-y   += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_GGML_QUANTS_FLAGS-y  += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_GGML_BACKEND_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_GGML_THREADING_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
# ── ggml-cpu hot kernels ─────────────────────────────────────────────────
APPLLAMA_UPSTREAM_GGML_CPU_FLAGS-y      += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_QUANTS_FLAGS-y        += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_BINARY_OPS_FLAGS-y    += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_UNARY_OPS_FLAGS-y     += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_VEC_FLAGS-y           += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_OPS_FLAGS-y           += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_REPACK_FLAGS-y        += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_TRAITS_FLAGS-y        += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_HBM_FLAGS-y           += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_GGML_CPU_CPP_FLAGS-y  += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
# ── x86 quant / repack kernels ───────────────────────────────────────────
APPLLAMA_UPSTREAM_X86_QUANTS_FLAGS-y    += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_X86_REPACK_FLAGS-y    += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_X86_CPU_FEATS_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
# ── llama.cpp high-level graph executor ──────────────────────────────────
APPLLAMA_UPSTREAM_LLAMA_FLAGS-y         += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_GRAPH_FLAGS-y   += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_CONTEXT_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_KV_CACHE_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_KV_CACHE_ISWA_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_MEMORY_FLAGS-y  += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_SAMPLER_FLAGS-y += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_BATCH_FLAGS-y   += $(APPLLAMA_UPSTREAM_HOT_FLAGS)
APPLLAMA_UPSTREAM_LLAMA_MODEL_FLAGS-y   += $(APPLLAMA_UPSTREAM_HOT_FLAGS)

# Single-purpose appliance entry points. Only one mode is compiled; the other
# source file becomes an empty translation unit thanks to its #if guard.
APPLLAMA_UPSTREAM_SRCS-$(CONFIG_APP_LLAMA_UPSTREAM_MODE_BENCH)  += $(APPLLAMA_UPSTREAM_BASE)/bench.cpp
APPLLAMA_UPSTREAM_SRCS-$(CONFIG_APP_LLAMA_UPSTREAM_MODE_SERVER) += $(APPLLAMA_UPSTREAM_BASE)/server.cpp

# ── ggml core ────────────────────────────────────────────────────────────────
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml.c
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-alloc.c
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-quants.c
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-backend.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-backend-meta.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-threading.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/gguf.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-opt.cpp

# Backend registry: GGML_USE_CPU causes static constructor to register CPU backend;
# dlopen calls in ggml_backend_load_best() will fail gracefully via posix-libdl stubs.
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-backend-dl.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-backend-reg.cpp

# ── ggml-cpu backend ─────────────────────────────────────────────────────────
APPLLAMA_UPSTREAM_SRCS-y += $(APPLLAMA_UPSTREAM_BASE)/ggml-cpu-cpp.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/ggml-cpu.c
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/quants.c
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/repack.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/hbm.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/traits.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(APPLLAMA_UPSTREAM_BASE)/dummy-amx.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/binary-ops.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/unary-ops.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/vec.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(GGML_SRC)/ggml-cpu/ops.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(APPLLAMA_UPSTREAM_BASE)/x86-quants.c
APPLLAMA_UPSTREAM_SRCS-y += $(APPLLAMA_UPSTREAM_BASE)/x86-repack.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(APPLLAMA_UPSTREAM_BASE)/x86-cpu-feats.cpp

# ── llama.cpp high-level layer ────────────────────────────────────────────────
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-adapter.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-arch.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-batch.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-chat.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-context.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-cparams.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-grammar.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-graph.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-hparams.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-impl.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-io.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-kv-cache.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-kv-cache-iswa.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-kv-cache-dsa.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-memory.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-memory-hybrid.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-memory-hybrid-iswa.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-memory-recurrent.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-mmap.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-model.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-model-loader.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-model-saver.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-quant.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-sampler.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/llama-vocab.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/unicode.cpp
APPLLAMA_UPSTREAM_SRCS-y += $(LLAMA_SRC)/unicode-data.cpp

# ── llama.cpp model implementations ──────────────────────────────────────────
# models/llama.cpp basename conflicts with src/llama.cpp; use a shim instead.
APPLLAMA_UPSTREAM_SRCS-y += $(filter-out $(LLAMA_SRC)/models/llama.cpp, \
                             $(wildcard $(LLAMA_SRC)/models/*.cpp))
APPLLAMA_UPSTREAM_SRCS-y += $(APPLLAMA_UPSTREAM_BASE)/models-llama.cpp
