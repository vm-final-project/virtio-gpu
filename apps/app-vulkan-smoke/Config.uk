config APP_VULKAN_SMOKE
	bool "Vulkan smoke test application (native Venus substrate gate)"
	default n
	select LIBUKVIRTIO_GPU
	select LIBUKSGLIST
	select LIBUKEGL
	help
	  Headless Vulkan smoke test for the VOGUE native Venus substrate.
	  Validates Venus capset detection without claiming rendering or
	  acceleration.  Based on Khronos Vulkan Samples patterns.
	  Evidence row: vk.smoke.
