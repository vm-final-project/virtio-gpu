################################################################################
# app-glmark2 — bounded official-source glmark2-es2 scene-clear port
################################################################################
# Unikraft porting-rule compliance:
# - register the application as a library with addlib
# - keep app variables under the APPGLMARK2 namespace
# - compile only the Unikraft adapter source selected by CONFIG_APP_GLMARK2
# - document the official upstream source reference used by the adapter

$(eval $(call addlib,appglmark2))

APPGLMARK2_UPSTREAM_REPO := https://github.com/glmark2/glmark2.git
APPGLMARK2_UPSTREAM_REF  := 22c527cb0556f3a1ac4445aaa52cc532760928d5
APPGLMARK2_UPSTREAM_PATH := src/scene-clear.cpp src/main.cpp

APPGLMARK2_SRCS-$(CONFIG_APP_GLMARK2) += $(APPGLMARK2_BASE)/main.c

CINCLUDES-$(CONFIG_APP_GLMARK2) += -I$(LIBUKEGL_BASE)/include
CFLAGS-$(CONFIG_APP_GLMARK2)    += -DGLMARK2_UPSTREAM_REF=\"$(APPGLMARK2_UPSTREAM_REF)\"
