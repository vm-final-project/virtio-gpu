$(eval $(call addlib,appkmscube))

APPKMSCUBE_SRCS-$(CONFIG_APP_KMSCUBE) += $(APPKMSCUBE_BASE)/main.c
APPKMSCUBE_SRCS-$(CONFIG_APP_KMSCUBE) += $(APPKMSCUBE_BASE)/uk_glue.c
APPKMSCUBE_SRCS-$(CONFIG_APP_KMSCUBE) += $(APPKMSCUBE_BASE)/upstream/cube-smooth.c
APPKMSCUBE_SRCS-$(CONFIG_APP_KMSCUBE) += $(APPKMSCUBE_BASE)/upstream/esTransform.c

CINCLUDES-$(CONFIG_APP_KMSCUBE) += -I$(LIBUKEGL_BASE)/include
CINCLUDES-$(CONFIG_APP_KMSCUBE) += -I$(APPKMSCUBE_BASE)/../../libs/libukvulkan_venus/include
CINCLUDES-$(CONFIG_APP_KMSCUBE) += -I$(APPKMSCUBE_BASE)
