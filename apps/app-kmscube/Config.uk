config APP_KMSCUBE
	bool "KMScube VirtIO-GPU-GL application (virgl path)"
	default n
	select LIBUKSGLIST
	select LIBUKALLOC
	select LIBUKVIRTIO_GPU
	select LIBUKVULKAN_VENUS
	help
	  KMScube ported to Unikraft. Renders via the virgl/Gallium path
	  directly through libukvirtio_gpu (uk_virgl_encode_* + SUBMIT_3D).
	  Evidence rows: gfx.kmscube.submit, gfx.kmscube.frame.
	  No EGL, GBM, DRM compat, or software renderer required.
