spec: v0.6

name: vogue-llama-vk-upstream-bench

# Upstream llama-bench Vulkan single-application appliance.
# This image calls tools/llama-bench/llama-bench.cpp with -ngl 99 through
# the VOGUE Vulkan/Venus dispatch, not the VOGUE hand-rolled pp/tg loop.

unikraft:
  source: @@UNIKRAFT_LOCAL@@
  kconfig:
    CONFIG_APP_LLAMA_VK: 'y'
    CONFIG_APP_LLAMA_VK_ROOTFS_9PFS: 'y'
    CONFIG_APP_LLAMA_VK_MODE_BENCH: 'y'
    CONFIG_APP_LLAMA_VK_BENCH_UPSTREAM: 'y'
    CONFIG_APP_LLAMA_VK_THREADS: '@@VOGUE_SMP@@'
    CONFIG_OPTIMIZE_DEADELIM: 'y'
    CONFIG_LIBUKINTCTLR_GICV2: 'y'
    CONFIG_STACK_SIZE_PAGE_ORDER: '9'
    CONFIG_AUXSTACK_SIZE_PAGE_ORDER: '7'
    CONFIG_LIBUKPAGING: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBCXX: 'y'
    CONFIG_CXX_THREADS: 'y'
    CONFIG_LIBCXXABI: 'y'
    CONFIG_LIBUNWIND: 'y'
    CONFIG_LIBCOMPILER_RT: 'y'
    CONFIG_LIBPOSIX_TTY: 'y'
    CONFIG_LIBPOSIX_TTY_STDIO: 'y'
    CONFIG_LIBPOSIX_TTY_STDOUT_SERIAL: 'y'
    CONFIG_LIBPOSIX_TTY_STDIN_NULL: 'y'
    CONFIG_LIBPOSIX_PROCESS: 'y'
    CONFIG_LIBPOSIX_TIME: 'y'
    CONFIG_LIBPOSIX_MMAP: 'y'
    CONFIG_LIBPOSIX_VFS: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_RAMFS: 'y'
    CONFIG_LIBUK9P: 'y'
    CONFIG_LIBVIRTIO_9P: 'y'
    CONFIG_LIB9PFS: 'y'
    CONFIG_LIBUKSGLIST: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'
    CONFIG_LIBUKVULKAN_VENUS: 'y'
    CONFIG_LIBVULKAN: 'y'

targets:
  - qemu/x86_64
  - qemu/arm64

libraries:
  musl: stable
  libcxx: stable
  libcxxabi: stable
  libunwind: stable
  compiler-rt: stable
  libukvirtio_gpu:
    source: ./libs/libukvirtio_gpu
  libukvulkan_venus:
    source: ./libs/libukvulkan_venus
  libvulkan:
    source: ./libs/libvulkan
  app-llama-vk:
    source: ./apps/app-llama-vk
