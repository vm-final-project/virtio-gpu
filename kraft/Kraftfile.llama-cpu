spec: v0.6

name: vogue-llama-cpu

# Upstream llama.cpp CPU path (llm.bench.cpu gate).
# Uses unmodified upstream llama.cpp linked as libllama.a via
# cmake/unikraft-clang.cmake. Upstream lib-musl supplies sysconf/getauxval/prctl
# stubs and pthread_setaffinity_np; no local POSIX shim is required.

unikraft:
  source: @@UNIKRAFT_LOCAL@@
  kconfig:
    CONFIG_APP_LLAMA_CPU: 'y'
    CONFIG_APP_LLAMA_CPU_ROOTFS_9PFS: 'y'
    CONFIG_APP_LLAMA_CPU_MODE_BENCH: 'y'
    CONFIG_APP_LLAMA_CPU_THREADS: '1'
    CONFIG_OPTIMIZE_DEADELIM: 'y'
    # Match the server appliance: a deep llama.cpp graph-build call chain needs a
    # larger stack, and LIBUKPAGING maps all RAM into one contiguous heap so the
    # bench compute buffers (e.g. a ~516 MB pp512 buffer) can be allocated.
    # Without paging the boot allocator feeds fragmented physical regions and the
    # context-init alloc fails ("insufficient memory") regardless of -m.
    CONFIG_STACK_SIZE_PAGE_ORDER: '9'
    CONFIG_LIBUKPAGING: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBCXX: 'y'
    CONFIG_CXX_THREADS: 'y'
    CONFIG_LIBCXXABI: 'y'
    CONFIG_LIBUNWIND: 'y'
    CONFIG_LIBCOMPILER_RT: 'y'
    CONFIG_LIBPOSIX_TTY: 'y'
    CONFIG_LIBPOSIX_TTY_STDIO: 'y'
    CONFIG_LIBPOSIX_TTY_STDOUT_SERIAL: 'y'
    CONFIG_LIBPOSIX_TTY_STDIN_NULL: 'y'
    CONFIG_LIBPOSIX_PROCESS: 'y'
    CONFIG_LIBPOSIX_TIME: 'y'
    CONFIG_LIBPOSIX_MMAP: 'y'
    CONFIG_LIBPOSIX_VFS: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_RAMFS: 'y'
    CONFIG_LIBUK9P: 'y'
    CONFIG_LIBVIRTIO_9P: 'y'
    CONFIG_LIB9PFS: 'y'
    CONFIG_LIBPTHREAD_EMBEDDED: 'y'
    CONFIG_LIBPOSIX_LIBDL: 'y'

targets:
  - qemu/x86_64
  - qemu/arm64

libraries:
  musl: stable
  libcxx: stable
  libcxxabi: stable
  libunwind: stable
  compiler-rt: stable
  app-llama-cpu:
    source: ./apps/app-llama-cpu
