spec: v0.6

name: vogue-llama-cpu-bench

# Bench-only upstream llama.cpp CPU single-application appliance.
# Uses unmodified upstream llama.cpp linked as libllama.a via
# cmake/unikraft-clang.cmake; upstream lib-musl supplies the POSIX surface.

unikraft:
  source: @@UNIKRAFT_LOCAL@@
  kconfig:
    CONFIG_APP_LLAMA_CPU: 'y'
    CONFIG_APP_LLAMA_CPU_ROOTFS_9PFS: 'y'
    CONFIG_APP_LLAMA_CPU_MODE_BENCH: 'y'
    CONFIG_APP_LLAMA_CPU_THREADS: '@@VOGUE_SMP@@'
    CONFIG_OPTIMIZE_DEADELIM: 'y'
    # Match the working CPU image: llama.cpp requires the larger stack, while
    # paging supplies the runtime mapping adopted by secondary LCPUs.
    CONFIG_STACK_SIZE_PAGE_ORDER: '9'
    CONFIG_LIBUKPAGING: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBCXX: 'y'
    CONFIG_CXX_THREADS: 'y'
    CONFIG_LIBCXXABI: 'y'
    CONFIG_LIBUNWIND: 'y'
    CONFIG_LIBCOMPILER_RT: 'y'
    CONFIG_LIBPOSIX_TTY: 'y'
    CONFIG_LIBPOSIX_TTY_STDIO: 'y'
    CONFIG_LIBPOSIX_TTY_STDOUT_SERIAL: 'y'
    CONFIG_LIBPOSIX_TTY_STDIN_NULL: 'y'
    CONFIG_LIBPOSIX_PROCESS: 'y'
    CONFIG_LIBUKSCHED_PLACEMENT_TRACE: 'y'
    CONFIG_LIBUKPRINT_KLVL_INFO: 'y'
    CONFIG_LIBPOSIX_TIME: 'y'
    CONFIG_LIBPOSIX_MMAP: 'y'
    CONFIG_LIBPOSIX_VFS: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_RAMFS: 'y'
    CONFIG_LIBUK9P: 'y'
    CONFIG_LIBVIRTIO_9P: 'y'
    CONFIG_LIB9PFS: 'y'
    CONFIG_LIBPOSIX_LIBDL: 'y'
    # Four scheduler instances are required to capture the Task 1 placement
    # baseline; INFO is the level used by the guarded SMPPLACE records.
    CONFIG_UKPLAT_CPU_MAXCOUNT: '4'
    CONFIG_LIBUKSCHEDCOOP_SMP: 'y'

targets:
  - qemu/x86_64
  - qemu/arm64

libraries:
  musl: stable
  libcxx: stable
  libcxxabi: stable
  libunwind: stable
  compiler-rt: stable
  app-llama-cpu:
    source: ./apps/app-llama-cpu
