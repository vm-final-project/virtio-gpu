spec: v0.6

name: uk-kmscube-vgpu-gl

unikraft:
  source: @@UNIKRAFT_LOCAL@@
  kconfig:
    CONFIG_APP_KMSCUBE: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBUKSGLIST: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'

targets:
