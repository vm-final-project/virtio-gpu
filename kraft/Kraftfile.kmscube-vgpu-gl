spec: v0.6

name: uk-kmscube-vgpu-gl

unikraft:
  source: ../unikraft
  kconfig:
    CONFIG_APP_KMSCUBE: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBUKDMA: 'y'
    CONFIG_LIBUKBUF: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'
    CONFIG_LIBUKSWRENDER: 'y'
    CONFIG_LIBUKEGL: 'y'
    CONFIG_LIBUKDRM_COMPAT: 'y'
    CONFIG_LIBUKGBM_COMPAT: 'y'

targets:
- qemu/x86_64

libraries:
  libmusl:
    source: ../lib-musl
  libukdma:
    source: ./libs/libukdma
  libukbuf:
    source: ./libs/libukdma_pool
  libukvirtio_gpu:
    source: ./libs/libukvirtio_gpu
  libukswrender:
    source: ./libs/libukswrender
  libukegl:
    source: ./libs/libukegl
  libukdrm_compat:
    source: ./libs/libukdrm_compat
  libukgbm_compat:
    source: ./libs/libukgbm_compat
  app-kmscube:
    source: ./apps/app-kmscube
