spec: v0.6

name: uk-kmscube-vgpu-gl

unikraft:
  source: https://github.com/unikraft/unikraft.git
  version: f6f00b2d9cf4826ed9729bb62738947f82bf1f6e
  kconfig:
    CONFIG_APP_KMSCUBE: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBUKSGLIST: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'

targets:
- qemu/x86_64
- qemu/arm64

libraries:
  musl: stable
  libukvirtio_gpu:
    source: ./libs/libukvirtio_gpu
  app-kmscube:
    source: ./apps/app-kmscube
