spec: v0.6

name: vogue-llama-vk-server

# Upstream llama.cpp Vulkan server-only single-application appliance
# (llm.server.vk gate). Same Venus dispatch chain as the bench appliance
# (in-tree ggml-vulkan → libvulkan → libukvulkan_venus SUBMIT_3D → virtio-gpu-gl-pci,venus=true);
# the only difference is the Kconfig mode, which compiles server.cpp
# instead of bench.cpp.
#
# Reference QEMU invocation (plan-optimize.md L4.1/L4.2 + HTTP serving):
#   qemu-system-x86_64 -machine accel=kvm -cpu max -m 4G \
#       -kernel .unikraft/build/vogue-llama-vk-server_qemu-x86_64 \
#       -append "console=ttyS0 random.seed=<8 u32 words>" \
#       -display egl-headless,gl=on \
#       -device virtio-gpu-gl-pci,hostmem=8G,blob=true,venus=true \
#       -netdev user,id=net0,hostfwd=tcp:127.0.0.1:18080-10.0.2.15:8080 \
#       -device virtio-net-pci,netdev=net0 \
#       -virtfs local,path=$(pwd)/rootfs/llama,mount_tag=model,security_model=none,id=model \
#       -serial mon:stdio
#   # then: curl http://127.0.0.1:18080/health  ->  {"status":"ok"}
# See python3 -m scripts.vogue capture vk-server for the canonical command.
# The hostmem=8G window backs Venus host-visible blobs (KV cache); blob=true
# is required for that mapping; venus=true exposes capset id=4 to the guest.
# See python3 -m scripts.vogue evaluate server-vk for the gate that records the host
# device flags alongside any same-run llama.cpp request metrics.

unikraft:
  source: ../unikraft
  kconfig:
    CONFIG_APP_LLAMA_VK: 'y'
    CONFIG_APP_LLAMA_VK_ROOTFS_9PFS: 'y'
    CONFIG_APP_LLAMA_VK_MODE_SERVER: 'y'
    # P0 (plan-optimize.md): guest SMP so the 4 continuous-batching slots can
    # overlap their CPU work (sampling/HTTP) across multiple vCPUs instead of
    # serialising on one. UKPLAT_CPU_MAXCOUNT>1 auto-selects HAVE_SMP + APIC/ACPI.
    # Boot with QEMU -smp 4; the server runs with --threads 4.
    CONFIG_UKPLAT_CPU_MAXCOUNT: '4'
    CONFIG_APP_LLAMA_VK_THREADS: '4'
    # Continuous batching: 4 server slots so concurrent HTTP requests decode in
    # one batched forward pass (plan-optimize.md L2.2; llama.cpp Discussion
    # #18308). server.cpp scales --ctx-size to PARALLEL*CTX so each slot keeps
    # its full per-slot window.
    CONFIG_APP_LLAMA_VK_PARALLEL: '4'
    CONFIG_APP_LLAMA_VK_BATCH: '2048'
    CONFIG_APP_LLAMA_VK_UBATCH: '512'
    CONFIG_OPTIMIZE_DEADELIM: 'y'
    # See Kraftfile.llama-vk: ggml-vulkan's async pipeline-compile
    # workers + the compute-graph dispatch overflow the 64 KiB default thread
    # stack; 512 KiB per thread is required for the Venus path to run reliably.
    CONFIG_STACK_SIZE_PAGE_ORDER: '7'
    CONFIG_AUXSTACK_SIZE_PAGE_ORDER: '7'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBCXX: 'y'
    CONFIG_CXX_THREADS: 'y'
    CONFIG_LIBCXXABI: 'y'
    CONFIG_LIBUNWIND: 'y'
    CONFIG_LIBCOMPILER_RT: 'y'
    CONFIG_LIBPOSIX_TTY: 'y'
    CONFIG_LIBPOSIX_TTY_STDIO: 'y'
    CONFIG_LIBPOSIX_TTY_STDOUT_SERIAL: 'y'
    CONFIG_LIBPOSIX_TTY_STDIN_NULL: 'y'
    CONFIG_LIBPOSIX_PROCESS: 'y'
    CONFIG_LIBPOSIX_TIME: 'y'
    CONFIG_LIBPOSIX_MMAP: 'y'
    CONFIG_LIBPOSIX_VFS: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_RAMFS: 'y'
    CONFIG_LIBUK9P: 'y'
    CONFIG_LIBVIRTIO_9P: 'y'
    CONFIG_LIB9PFS: 'y'
    CONFIG_LIBPTHREAD_EMBEDDED: 'y'
    CONFIG_LIBUKSGLIST: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'
    CONFIG_LIBUKVULKAN_VENUS: 'y'
    CONFIG_LIBVULKAN: 'y'
    # posix-socket provides the socket()/bind()/listen()/accept() API the
    # upstream cpp-httplib server references; lwIP (below) is the TCP/IP backend
    # that registers the AF_INET socket family, so the upstream HTTP listener now
    # binds 0.0.0.0:8080 and actually serves requests inside the unikernel.
    CONFIG_LIBPOSIX_SOCKET: 'y'
    # --- TCP/IP networking for the upstream llama.cpp HTTP server -------------
    # virtio-net NIC -> libuknetdev -> lwIP (sockets API). Static IPv4 config is
    # passed on the kernel command line through the uknetdev EINFO libparam
    # (netdev.ipv4_addr/…); QEMU user-mode networking (-netdev user,hostfwd=…)
    # forwards a host port to guest 8080. See python3 -m scripts.vogue capture vk-server.
    CONFIG_LIBVIRTIO_NET: 'y'
    CONFIG_LIBUKNETDEV: 'y'
    CONFIG_LIBUKNETDEV_EINFO_LIBPARAM: 'y'
    CONFIG_LIBUKSCHED: 'y'
    CONFIG_LIBLWIP: 'y'
    CONFIG_LWIP_UNIKRAFT21X: 'y'
    CONFIG_LWIP_UKNETDEV: 'y'
    CONFIG_LWIP_AUTOIFACE: 'y'
    # QEMU user-mode networking runs a built-in DHCP server that hands the guest
    # 10.0.2.15; lwIP's DHCP client configures en1 from it (same approach as the
    # upstream catalog http-c/nginx appliances). This is more robust than a
    # static einfo config across netdev indices.
    CONFIG_LWIP_DHCP: 'y'
    CONFIG_LWIP_IPV4: 'y'
    CONFIG_LWIP_UDP: 'y'
    CONFIG_LWIP_TCP: 'y'
    CONFIG_LWIP_THREADS: 'y'
    CONFIG_LWIP_SOCKET: 'y'
    CONFIG_LWIP_NETIF_STATUS_PRINT: 'y'
    # The upstream cpp-httplib server uses std::random_device, which opens
    # /dev/urandom. Provide it via ukrandom's devfs nodes; the CSPRNG is seeded
    # from the kernel command line (random.seed=…) because QEMU/x86 has no DTB.
    CONFIG_LIBUKRANDOM: 'y'
    CONFIG_LIBUKRANDOM_CMDLINE_SEED: 'y'
    CONFIG_LIBUKRANDOM_GETRANDOM: 'y'
    CONFIG_LIBUKRANDOM_DEVFS: 'y'
    CONFIG_LIBDEVFS: 'y'
    CONFIG_LIBDEVFS_AUTOMOUNT: 'y'

targets:
  - qemu/x86_64

libraries:
  libmusl:
    source: ../lib-musl
  libcxx:
    source: ../lib-libcxx
  libcxxabi:
    source: ../lib-libcxxabi
  libunwind:
    source: ../lib-libunwind
  libcompiler-rt:
    source: ../lib-compiler-rt
  liblwip:
    source: ../lib-lwip
  libukvirtio_gpu:
    source: ./libs/libukvirtio_gpu
  libukvulkan_venus:
    source: ./libs/libukvulkan_venus
  libvulkan:
    source: ./libs/libvulkan
  app-llama-vk:
    source: ./apps/app-llama-vk
