spec: v0.6

name: vogue-glmark2

unikraft:
  source: ../unikraft
  kconfig:
    CONFIG_APP_GLMARK2: 'y'
    CONFIG_LIBMUSL: 'y'
    CONFIG_LIBUKSGLIST: 'y'
    CONFIG_LIBUKVIRTIO_GPU: 'y'
    CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL: 'y'
    CONFIG_LIBUKSWRENDER: 'y'
    CONFIG_LIBUKEGL: 'y'
    CONFIG_LIBUKDRM_COMPAT: 'y'
    CONFIG_LIBUKGBM_COMPAT: 'y'

targets:
- qemu/x86_64

libraries:
  libmusl:
    source: ../lib-musl
  libukvirtio_gpu:
    source: ./libs/libukvirtio_gpu
  libukswrender:
    source: ./libs/libukswrender
  libukegl:
    source: ./libs/libukegl
  libukdrm_compat:
    source: ./libs/libukdrm_compat
  libukgbm_compat:
    source: ./libs/libukgbm_compat
  app-glmark2:
    source: ./apps/app-glmark2
