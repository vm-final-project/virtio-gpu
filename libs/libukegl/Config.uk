config LIBUKEGL
	bool "libukegl: EGL shim for virtio-gpu-gl"
	default n
	select LIBUKVIRTIO_GPU
	select LIBUKSGLIST
	select LIBUKALLOC
	select LIBUKSWRENDER
	select LIBMUSL
	help
	  Bounded EGL 1.5 shim that creates virgl contexts via libukvirtio_gpu
	  and exposes surfaces backed by virtio-gpu 2D resources.  The GLES2
	  rendering path runs through libukswrender (software) when no real
	  virgl GPU context is available, and through libukgles2virgl otherwise.
	  Scope: bounded kmscube / glmark2 porting only.
