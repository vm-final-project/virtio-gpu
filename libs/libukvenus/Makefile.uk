$(eval $(call addlib,libukvenus))

LIBUKVENUS_SRCS-y += $(LIBUKVENUS_BASE)/venus_cs.c
LIBUKVENUS_SRCS-y += $(LIBUKVENUS_BASE)/venus_init.c
LIBUKVENUS_SRCS-y += $(LIBUKVENUS_BASE)/venus_compute.c

LIBUKVENUS_CINCLUDES-y += -I$(LIBUKVENUS_BASE)/include
LIBUKVENUS_CINCLUDES-y += -I$(LIBUKVIRTIO_GPU_BASE)/include

# The in-image encoders route Vulkan calls through the driver headers generated
# from the pinned ../venus-protocol (see GENERATOR.md). Those headers + the
# vn_cs/vn_ring shim need the bare include dir, the generated dir, and stock
# Vulkan headers (VULKAN_HEADERS_INCLUDE, the same set libukggml_vk uses).
VULKAN_HEADERS_INCLUDE ?= $(LIBUKVENUS_BASE)/../../../Vulkan-Headers/include
LIBUKVENUS_CINCLUDES-y += -I$(LIBUKVENUS_BASE)/include/uk
LIBUKVENUS_CINCLUDES-y += -I$(LIBUKVENUS_BASE)/generated
LIBUKVENUS_CINCLUDES-y += -I$(VULKAN_HEADERS_INCLUDE)
# Generated encoders are upstream-shaped; silence their stylistic warnings.
LIBUKVENUS_CFLAGS-y += -Wno-unused-parameter -Wno-missing-field-initializers
