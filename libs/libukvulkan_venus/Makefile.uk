$(eval $(call addlib,libukvulkan_venus))

# Venus Vulkan driver implementation (flat layout, mirrors Mesa src/virtio/vulkan/).
# vn_renderer_virtgpu.c  — Mesa-like device params/capset/context boundary
# vn_driver.c            — Unikraft-native driver open/probe bootstrap
# vn_cs.c               — command-stream encoder
# vn_ring.c             — capset, context, ring-buffer protocol, SUBMIT_3D
# vn_buffer.c          — compute dispatch encoder
# vn_command_buffer.c          — compute dispatch encoder
# vn_descriptor_set.c          — compute dispatch encoder
# vn_device_memory.c          — compute dispatch encoder
# vn_pipeline.c          — compute dispatch encoder
# vn_queue.c          — compute dispatch encoder
# vn_renderer_util.c    — capset decode helper
# vn_ring_shim.c        — generated ring transport adapter
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_renderer_virtgpu.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_driver.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_renderer_util.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_cs.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_ring.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_buffer.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_command_buffer.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_descriptor_set.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_device_memory.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_pipeline.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_queue.c
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/vn_ring_shim.c

LIBUKVULKAN_VENUS_CINCLUDES-y += -I$(LIBUKVULKAN_VENUS_BASE)/include
LIBUKVULKAN_VENUS_CINCLUDES-y += -I$(LIBUKVIRTIO_GPU_BASE)/include

# The in-image encoders route Vulkan calls through the driver headers generated
# from the pinned ../venus-protocol (see GENERATOR.md). Those headers + the
# vn_cs/vn_ring shim need the bare include dir, the generated dir, and stock
# Vulkan headers (VULKAN_HEADERS_INCLUDE, the same set libvulkan uses).
VULKAN_HEADERS_INCLUDE ?= $(LIBUKVULKAN_VENUS_BASE)/../../.deps/src/Vulkan-Headers/include
LIBUKVULKAN_VENUS_CINCLUDES-y += -I$(LIBUKVULKAN_VENUS_BASE)/include/uk
LIBUKVULKAN_VENUS_CINCLUDES-y += -I$(LIBUKVULKAN_VENUS_BASE)/generated
LIBUKVULKAN_VENUS_CINCLUDES-y += -I$(VULKAN_HEADERS_INCLUDE)
# Generated encoders are upstream-shaped; silence their stylistic warnings.
LIBUKVULKAN_VENUS_CFLAGS-y += -Wno-unused-parameter -Wno-missing-field-initializers

ifneq ($(filter y,$(CONFIG_LIBUKVULKAN_VENUS_TEST_ENCODER) $(CONFIG_LIBUKTEST_ALL)),)
LIBUKVULKAN_VENUS_SRCS-y += $(LIBUKVULKAN_VENUS_BASE)/tests/test_encoder.c
endif
