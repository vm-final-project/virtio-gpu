config LIBUKVIRTIO_GPU
	bool "libukvirtio_gpu"
	default n
	help
	  VirtIO-GPU guest frontend for Unikraft. Requires the real VirtIO
	  bus backend for QEMU/PCIe virtio-gpu evidence. The fake test backend
	  lives in tests/virtio_gpu_fake.c and is compiled directly by the
	  native test harness — it is not part of this library.

config LIBUKVIRTIO_GPU_BACKEND_REAL
	bool "real Unikraft virtio-gpu backend"
	depends on LIBUKVIRTIO_GPU
	default y if LIBUKVIRTIO_GPU
	select VIRTIO_DEVICE
	select LIBVIRTIO_BUS
	select LIBUKSGLIST
	select LIBUKALLOC
	select LIBUKLOCK
	select LIBUKLOCK_MUTEX
	help
	  Real guest driver for QEMU/PCIe virtio-gpu device using Unikraft's
	  virtio bus, control queue, and resource commands. The control queue is
	  serialised with a uk_mutex (mirrors the Linux virtio-gpu ctrlq.qlock) so
	  ggml-vulkan's concurrent pipeline-compile threads can share it safely.

if LIBUKVIRTIO_GPU

config LIBUKVIRTIO_GPU_PROFILING
	bool "VOGUE Venus-path profiling counters"
	default n
	depends on LIBUKVIRTIO_GPU_BACKEND_REAL
	help
	  Per-phase L2/L3/L4 timing of the Venus dispatch path, emitted as
	  VOGUE-TIMING lines (parsed by scripts/common.py). It adds two
	  monotonic-clock reads per encoded command on the dispatch hot path
	  (~8M per decode run), which inflates the measured region and deflates
	  reported t/s by a few percent. Keep OFF for performance numbers;
	  enable only to profile where time goes.

config LIBUKVIRTIO_GPU_TEST
	bool "Enable unit tests"
	default n
	select LIBUKTEST
	depends on LIBUKVIRTIO_GPU_BACKEND_REAL

config LIBUKVIRTIO_GPU_TEST_CORE
	bool "Core helper tests"
	default y
	depends on LIBUKVIRTIO_GPU_TEST
	help
	  Small uktest suite for the stable helper surface: capset naming and
	  APIR header encode/decode helpers.

endif
