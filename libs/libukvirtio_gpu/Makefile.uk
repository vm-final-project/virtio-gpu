$(eval $(call addlib,libukvirtio_gpu))
CINCLUDES-$(CONFIG_LIBUKVIRTIO_GPU) += -I$(LIBUKVIRTIO_GPU_BASE)/include
CXXINCLUDES-$(CONFIG_LIBUKVIRTIO_GPU) += -I$(LIBUKVIRTIO_GPU_BASE)/include

# Real backend mirrors Unikraft's built-in virtio driver include pattern.
LIBUKVIRTIO_GPU_CINCLUDES-$(CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL) += -I$(CONFIG_UK_BASE)/drivers/virtio/bus/include
LIBUKVIRTIO_GPU_CINCLUDES-$(CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL) += -I$(CONFIG_UK_BASE)/drivers/virtio/ring/include
LIBUKVIRTIO_GPU_CINCLUDES-$(CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL) += -I$(CONFIG_UK_BASE)/drivers/virtio/include
LIBUKVIRTIO_GPU_CINCLUDES-$(CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL) += -I$(CONFIG_UK_BASE)/plat/common/include
LIBUKVIRTIO_GPU_SRCS-$(CONFIG_LIBUKVIRTIO_GPU_BACKEND_REAL) += $(LIBUKVIRTIO_GPU_BASE)/virtio_gpu_real.c

# Gallium/virgl command stream encoder (K1 render path; nolibc-safe pure C).
LIBUKVIRTIO_GPU_SRCS-$(CONFIG_LIBUKVIRTIO_GPU) += $(LIBUKVIRTIO_GPU_BASE)/virgl_encoder.c
